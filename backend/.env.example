# Hidani Tech AI Job Assistant - Environment Configuration

# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data Storage
DATA_DIR=data
JOBS_FILE=data/jobs.json
APPLICATIONS_FILE=data/applications.json
SESSIONS_FILE=data/sessions.json

# File Upload
MAX_UPLOAD_SIZE_BYTES=5242880

# LLM Configuration (Set your preferred provider: gemini | openai | anthropic | groq | mock)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# Provider API Keys (leave blank or fill with your personal keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
